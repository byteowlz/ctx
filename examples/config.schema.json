{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/byteowlz/ctx/schemas/config.schema.json",
  "title": "ctx configuration",
  "description": "Configuration schema for ctx",
  "type": "object",
  "properties": {
    "capture": {
      "type": "object",
      "properties": {
        "include_clipboard": {
          "type": "boolean",
          "default": false
        },
        "include_screenshots": {
          "type": "boolean",
          "default": true
        },
        "include_accessibility": {
          "type": "boolean",
          "default": true
        },
        "include_actions": {
          "type": "boolean",
          "default": false
        },
        "accessibility_depth": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16,
          "default": 3
        },
        "image_quality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 85
        },
        "screenshot_timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "default": 2000
        }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "properties": {
        "default_provider": {
          "type": ["string", "null"]
        },
        "api_keys": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "capture_dir": {
          "type": ["string", "null"]
        },
        "state_file": {
          "type": ["string", "null"],
          "description": "Path to the lightweight current-context JSON state file, typically $XDG_STATE_HOME/ctx/current-context.json."
        },
        "bundle_dir": {
          "type": ["string", "null"],
          "description": "Central directory where ctx context bundles are stored."
        }
      },
      "additionalProperties": false
    },
    "bar": {
      "type": "object",
      "description": "Native ctx-bar preferences. Input theme changes remain local to the running app.",
      "additionalProperties": false,
      "properties": {
        "theme": {"enum": ["Lumen Dark", "Lumen Light"], "default": "Lumen Dark"},
        "design": {"enum": ["underline", "monolith", "lens", "signal", "prompt", "dot-matrix", "corners", "slot", "unframed", "notch"], "default": "dot-matrix"},
        "presentation": {"enum": ["flat", "branches"], "default": "flat"},
        "platform": {"enum": ["macos", "windows", "linux", "omarchy"]},
        "fixture": {"enum": ["desktop", "selection", "audio", "unavailable"], "default": "desktop"},
        "auto_select_first": {"type": "boolean", "default": false},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30, "default": 3},
        "debounce_ms": {"type": "integer", "minimum": 100, "maximum": 2000, "default": 220},
        "request_timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 30, "default": 15},
        "width": {"type": "number", "minimum": 480, "maximum": 1200, "default": 680},
        "height": {"type": "number", "minimum": 240, "maximum": 900, "default": 520, "description": "Maximum expansion height; idle height is design geometry (56 or 64)."}
      }
    },
    "eavs": {
      "type": "object",
      "description": "Jev routing via the local EAVS listener (or a loopback SSH tunnel). Credentials stay backend-only.",
      "additionalProperties": false,
      "properties": {
        "endpoint": {"type": "string", "pattern": "^http://127\\.0\\.0\\.1(?::[0-9]+)?/", "default": "http://127.0.0.1:3033/jev/v1/systemone"},
        "model": {"type": "string", "minLength": 1, "default": "jev-latest"},
        "profile": {"type": "string", "description": "Existing authorized local EAVS credential profile; does not choose the provider."},
        "listener_token": {"type": "string", "writeOnly": true},
        "virtual_key": {"type": "string", "writeOnly": true}
      }
    },
    "ocr": {
      "type": "object",
      "description": "OCR backend configuration for bundle image OCR.",
      "properties": {
        "command": {
          "type": "string",
          "default": "ocrs",
          "description": "Command used to run OCR on bundle images."
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "auto_crops": {
          "type": "boolean",
          "default": true,
          "description": "Automatically OCR crops when they are created."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
