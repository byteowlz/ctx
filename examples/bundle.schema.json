{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/byteowlz/ctx/schemas/bundle.schema.json",
  "title": "ctx context bundle manifest",
  "description": "Context bundle manifest v1 owned by ctx for Omni Agent Handoff and other tools.",
  "type": "object",
  "required": ["schema_version", "id", "created_at", "updated_at", "state", "producer", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1, "description": "Manifest schema version." },
    "id": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}-[0-9]{2}-[0-9]{2}Z_[0-9a-z]{6}(_[0-9a-z0-9-]+)?$",
      "description": "Stable bundle id: timestamp + short id + optional slug."
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "state": { "type": "string", "enum": ["draft", "sent", "archived", "cancelled"] },
    "slug": { "type": ["string", "null"] },
    "producer": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "version": { "type": ["string", "null"] }
      }
    },
    "items": { "type": "array", "items": { "$ref": "#/definitions/item" } },
    "handoffs": { "type": "array", "items": { "$ref": "#/definitions/handoffRecord" } },
    "warnings": { "type": "array", "items": { "$ref": "#/definitions/warning" } },
    "export": { "$ref": "#/definitions/exportMeta" },
    "unresolved_refs": { "type": "array", "items": { "$ref": "#/definitions/unresolvedRef" } }
  },
  "definitions": {
    "item": {
      "type": "object",
      "required": ["id", "created_at", "kind"],
      "discriminator": { "propertyName": "kind" },
      "oneOf": [
        { "$ref": "#/definitions/imageItem" },
        { "$ref": "#/definitions/textItem" },
        { "$ref": "#/definitions/fileItem" },
        { "$ref": "#/definitions/urlItem" },
        { "$ref": "#/definitions/desktopSnapshotItem" }
      ]
    },
    "dimensions": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": { "width": { "type": "integer", "minimum": 0 }, "height": { "type": "integer", "minimum": 0 } }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 0 },
        "height": { "type": "integer", "minimum": 0 }
      }
    },
    "imageProvenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "app": { "type": ["string", "null"] },
        "window_title": { "type": ["string", "null"] },
        "url": { "type": ["string", "null"] },
        "display": { "type": ["string", "null"] },
        "mode": { "type": ["string", "null"], "enum": ["frontmost", "display", "all", null] },
        "rect": { "oneOf": [{ "$ref": "#/definitions/rect" }, { "type": "null" }] },
        "captured_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "imageItem": {
      "type": "object",
      "required": ["id", "created_at", "kind", "role", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "kind": { "type": "string", "const": "image" },
        "role": { "type": "string", "enum": ["screenshot", "crop", "pasted"] },
        "path": { "type": "string" },
        "mime": { "type": ["string", "null"] },
        "dimensions": { "oneOf": [{ "$ref": "#/definitions/dimensions" }, { "type": "null" }] },
        "provenance": { "$ref": "#/definitions/imageProvenance" },
        "ocr_refs": { "type": "array", "items": { "type": "string" } },
        "cropped_from": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "textItem": {
      "type": "object",
      "required": ["id", "created_at", "kind", "role", "storage"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "kind": { "type": "string", "const": "text" },
        "role": { "type": "string", "enum": ["task", "note", "clipboard", "ocr", "accessibility"] },
        "storage": { "type": "string", "enum": ["inline", "file"] },
        "text": { "type": ["string", "null"], "description": "Present when storage = inline." },
        "path": { "type": ["string", "null"], "description": "Present when storage = file." },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": { "type": ["string", "null"] },
            "window_title": { "type": ["string", "null"] },
            "note": { "type": ["string", "null"] }
          }
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "fileItem": {
      "type": "object",
      "required": ["id", "created_at", "kind", "policy"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "kind": { "type": "string", "const": "file" },
        "policy": { "type": "string", "enum": ["copied", "referenced"] },
        "bundle_path": { "type": ["string", "null"], "description": "Present when policy = copied." },
        "original_path": { "type": ["string", "null"], "description": "Present when policy = copied." },
        "path": { "type": ["string", "null"], "description": "Present when policy = referenced (absolute)." },
        "size_bytes": { "type": ["integer", "null"], "minimum": 0 },
        "mime": { "type": ["string", "null"] },
        "hash": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["algorithm", "value"],
              "properties": { "algorithm": { "type": "string" }, "value": { "type": "string" } }
            },
            { "type": "null" }
          ]
        },
        "note": { "type": ["string", "null"] }
      }
    },
    "urlItem": {
      "type": "object",
      "required": ["id", "created_at", "kind", "url"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "kind": { "type": "string", "const": "url" },
        "url": { "type": "string" },
        "title": { "type": ["string", "null"] },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": { "type": ["string", "null"] },
            "window_title": { "type": ["string", "null"] }
          }
        }
      }
    },
    "desktopSnapshotItem": {
      "type": "object",
      "required": ["id", "created_at", "kind", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "kind": { "type": "string", "const": "desktop_snapshot" },
        "path": { "type": "string" },
        "format": { "type": ["string", "null"] },
        "note": { "type": ["string", "null"] }
      }
    },
    "handoffRecord": {
      "type": "object",
      "required": ["target_id", "transport", "bundle_id", "status"],
      "additionalProperties": false,
      "properties": {
        "target_id": { "type": "string" },
        "transport": { "type": "string", "enum": ["local_process", "tmux", "oqto_api", "remote_agent", "queue"] },
        "bundle_id": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "sent", "delivered", "failed"] },
        "timestamps": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "queued_at": { "type": ["string", "null"], "format": "date-time" },
            "sent_at": { "type": ["string", "null"], "format": "date-time" },
            "delivered_at": { "type": ["string", "null"], "format": "date-time" },
            "failed_at": { "type": ["string", "null"], "format": "date-time" }
          }
        },
        "session_affinity_key": { "type": ["string", "null"] },
        "target_meta": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "command": { "type": ["string", "null"] },
            "endpoint": { "type": ["string", "null"] },
            "extra": {}
          }
        },
        "output": { "oneOf": [{ "type": "object", "required": ["path"], "additionalProperties": false, "properties": { "path": { "type": "string" } } }, { "type": "null" }] },
        "log": { "oneOf": [{ "type": "object", "required": ["path"], "additionalProperties": false, "properties": { "path": { "type": "string" } } }, { "type": "null" }] },
        "note": { "type": ["string", "null"] }
      }
    },
    "warning": {
      "type": "object",
      "required": ["code", "message", "created_at"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "item_id": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "exportMeta": {
      "type": "object",
      "required": ["format", "archive_version", "created_at", "archive_path", "manifest_path", "context_md_path"],
      "additionalProperties": false,
      "properties": {
        "format": { "type": "string" },
        "archive_version": { "type": "integer", "minimum": 0 },
        "created_at": { "type": "string", "format": "date-time" },
        "archive_path": { "type": "string" },
        "manifest_path": { "type": "string" },
        "context_md_path": { "type": "string" }
      }
    },
    "unresolvedRef": {
      "type": "object",
      "required": ["item_id", "path", "reason"],
      "additionalProperties": false,
      "properties": {
        "item_id": { "type": "string" },
        "path": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
