set shell := ["bash", "-cu"]

help:
    @just --list

check:
    cargo check --workspace --all-targets

fmt:
    cargo fmt --all

fmt-check:
    cargo fmt --all --check

test:
    cargo test --workspace

clippy:
    cargo clippy --workspace --all-targets -- -D warnings

check-all: check fmt-check clippy test

# Hidden synthetic native input/paint regression; no model or desktop capture.
benchmark-input *args:
    cargo run -p ctx-bar --features native-review --example input_lag -- --assert-single-grid {{args}}

# Actual hidden synthetic all-ten row/status/navigation scenes; explicit output.
review-surfaces directory:
    cargo run -p ctx-bar --features native-review --example surface_review -- --review-dir {{quote(directory)}}

# Only a human should launch this focus-taking native window.
run *args:
    cargo run -p ctx-bar -- {{args}}
