{"text": "öffne bitte die Datenschutzeinstellungen, ich will den Mikrofonzugriff prüfen", "label": "command", "lang": "de", "group": "long", "words": 9, "base:length<=4": "dictation", "base:lexical": "command", "jev:none:p": 0.99, "jev:none:ms": 160.80195899121463, "jev:editor:p": 0.28, "jev:editor:ms": 164.73479103296995, "d3-lite:none:p": 0.997835467082702, "d3-lite:none:ms": 197.23366596736014, "d3-lite:editor:p": 0.9881147054199623, "d3-lite:editor:ms": 120.0458329403773}
